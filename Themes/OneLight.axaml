<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="LiteReader.Themes.OneLight">

  <!-- One Light（亮） · 编辑器配色
       作者：hujie  创建：2026-09-18
       键名需与 App.axaml 的默认值、EditorSurface 的查询键保持一致。
       新增主题：复制本文件改色 → 在 ThemeService.Catalog 里登记。 -->


  <SolidColorBrush x:Key="EditorBackground" Color="#FAFAFA" />   <!-- 编辑器背景 -->
  <SolidColorBrush x:Key="EditorForeground" Color="#383A42" />   <!-- 编辑器正文 -->
  <SolidColorBrush x:Key="EditorGutterBackground" Color="#F0F0F1" />   <!-- 行号槽背景 -->
  <SolidColorBrush x:Key="EditorGutterForeground" Color="#9D9D9F" />   <!-- 行号文字 -->
  <SolidColorBrush x:Key="EditorCurrentLine" Color="#F2F2F3" />   <!-- 当前行高亮 -->
  <SolidColorBrush x:Key="EditorSelection" Color="#DBEDFF" />   <!-- 选中区 -->
  <SolidColorBrush x:Key="TokDefault" Color="#383A42" />   <!-- 默认 token -->
  <SolidColorBrush x:Key="TokKeyword" Color="#A626A4" />   <!-- 关键字 -->
  <SolidColorBrush x:Key="TokType" Color="#C18401" />   <!-- 类型/类名 -->
  <SolidColorBrush x:Key="TokString" Color="#50A14F" />   <!-- 字符串 -->
  <SolidColorBrush x:Key="TokNumber" Color="#986801" />   <!-- 数字 -->
  <SolidColorBrush x:Key="TokComment" Color="#A0A1A7" />   <!-- 注释 -->
  <SolidColorBrush x:Key="TokPreproc" Color="#0184BC" />   <!-- 预处理指令 -->
  <SolidColorBrush x:Key="TokBracket" Color="#383A42" />   <!-- 括号（兜底，实际走 Rb0..Rb5） -->

  <!-- 彩虹括号：按嵌套深度取色（取自 LiteReader.cpp 的 COLORREF rb[6]） -->
  <SolidColorBrush x:Key="Rb0" Color="#C23934" />
  <SolidColorBrush x:Key="Rb1" Color="#B58900" />
  <SolidColorBrush x:Key="Rb2" Color="#2F8A3B" />
  <SolidColorBrush x:Key="Rb3" Color="#1A85A3" />
  <SolidColorBrush x:Key="Rb4" Color="#1F6FBF" />
  <SolidColorBrush x:Key="Rb5" Color="#9241A3" />

  <SolidColorBrush x:Key="EditorMatchBackground" Color="#FFF3A0" />   <!-- 括号配对高亮 -->
  <SolidColorBrush x:Key="EditorMarkBackground" Color="#C0E6BF" />   <!-- 双击分词高亮（C++ markBg 0x00BFE6C0） -->

  <!-- 右侧滑动导航条（自绘） -->
  <SolidColorBrush x:Key="EditorOverviewBackground" Color="#EDEDED" />
  <SolidColorBrush x:Key="EditorOverviewThumb" Color="#C2C2C4" />

  <!-- 窗口外框（系统标题栏 + 四周那圈边框）跟随主题。
       这一套是亮色主题 —— 标题栏必须是浅底深字，否则就是「浅色正文 + 纯黑标题栏」的错配。
       机制与限制见 Services/WindowChrome.cs。 -->
  <SolidColorBrush x:Key="WindowCaptionBackground" Color="#F0F0F1" />   <!-- 标题栏底色（同行号槽，属外壳层） -->
  <SolidColorBrush x:Key="WindowCaptionForeground" Color="#383A42" />   <!-- 标题文字 -->
  <SolidColorBrush x:Key="WindowBorder" Color="#D8D8DA" />              <!-- 外边框 -->

  <!-- 代码补全候选列表（自绘） -->
  <SolidColorBrush x:Key="CompletionBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CompletionBorder" Color="#D0D0D0" />
  <SolidColorBrush x:Key="CompletionForeground" Color="#383A42" />
  <SolidColorBrush x:Key="CompletionSelectionBackground" Color="#DBEDFF" />
  <SolidColorBrush x:Key="CompletionSelectionForeground" Color="#000000" />

</ResourceDictionary>
