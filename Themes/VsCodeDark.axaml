<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="LiteReader.Themes.VsCodeDark">

  <!-- VS Code Dark+（暗） · 编辑器配色
       作者：hujie  创建：2026-09-18
       键名需与 App.axaml 的默认值、EditorSurface 的查询键保持一致。
       新增主题：复制本文件改色 → 在 ThemeService.Catalog 里登记。 -->


  <SolidColorBrush x:Key="EditorBackground" Color="#1E1E1E" />   <!-- 编辑器背景 -->
  <SolidColorBrush x:Key="EditorForeground" Color="#D4D4D4" />   <!-- 编辑器正文 -->
  <SolidColorBrush x:Key="EditorGutterBackground" Color="#1E1E1E" />   <!-- 行号槽背景 -->
  <SolidColorBrush x:Key="EditorGutterForeground" Color="#858585" />   <!-- 行号文字 -->
  <SolidColorBrush x:Key="EditorCurrentLine" Color="#282828" />   <!-- 当前行高亮 -->
  <SolidColorBrush x:Key="EditorSelection" Color="#264F78" />   <!-- 选中区 -->
  <SolidColorBrush x:Key="TokDefault" Color="#D4D4D4" />   <!-- 默认 token -->
  <SolidColorBrush x:Key="TokKeyword" Color="#569CD6" />   <!-- 关键字 -->
  <SolidColorBrush x:Key="TokType" Color="#4EC9B0" />   <!-- 类型/类名 -->
  <SolidColorBrush x:Key="TokString" Color="#CE9178" />   <!-- 字符串 -->
  <SolidColorBrush x:Key="TokNumber" Color="#B5CEA8" />   <!-- 数字 -->
  <SolidColorBrush x:Key="TokComment" Color="#6A9955" />   <!-- 注释 -->
  <SolidColorBrush x:Key="TokPreproc" Color="#C586C0" />   <!-- 预处理指令 -->
  <SolidColorBrush x:Key="TokBracket" Color="#D4D4D4" />   <!-- 括号（兜底，实际走 Rb0..Rb5） -->

  <!-- 彩虹括号：按嵌套深度取色（取自 LiteReader.cpp 的 COLORREF rb[6]） -->
  <SolidColorBrush x:Key="Rb0" Color="#FFE0AA" />
  <SolidColorBrush x:Key="Rb1" Color="#569CD6" />
  <SolidColorBrush x:Key="Rb2" Color="#86C6C0" />
  <SolidColorBrush x:Key="Rb3" Color="#CE9178" />
  <SolidColorBrush x:Key="Rb4" Color="#4EC9B0" />
  <SolidColorBrush x:Key="Rb5" Color="#669AD1" />

  <SolidColorBrush x:Key="EditorMatchBackground" Color="#37373D" />   <!-- 括号配对高亮 -->
  <SolidColorBrush x:Key="EditorMarkBackground" Color="#3A3232" />   <!-- 双击分词高亮（C++ markBg 0x0032323A） -->

  <!-- 右侧滑动导航条（自绘） -->
  <SolidColorBrush x:Key="EditorOverviewBackground" Color="#252526" />
  <SolidColorBrush x:Key="EditorOverviewThumb" Color="#424242" />

  <!-- 窗口外框跟随主题（取 VS Code 自己的 titleBar.activeBackground）。
       机制与平台限制见 Services/WindowChrome.cs。 -->
  <SolidColorBrush x:Key="WindowCaptionBackground" Color="#323233" />   <!-- 标题栏底色 -->
  <SolidColorBrush x:Key="WindowCaptionForeground" Color="#CCCCCC" />   <!-- 标题文字 -->
  <SolidColorBrush x:Key="WindowBorder" Color="#3C3C3C" />              <!-- 外边框 -->

  <!-- 代码补全候选列表（自绘） -->
  <SolidColorBrush x:Key="CompletionBackground" Color="#252526" />
  <SolidColorBrush x:Key="CompletionBorder" Color="#454545" />
  <SolidColorBrush x:Key="CompletionForeground" Color="#D4D4D4" />
  <SolidColorBrush x:Key="CompletionSelectionBackground" Color="#094771" />
  <SolidColorBrush x:Key="CompletionSelectionForeground" Color="#FFFFFF" />

</ResourceDictionary>
