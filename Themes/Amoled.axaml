<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="LiteReader.Themes.Amoled">

  <!-- 极致黑 AMOLED（暗） · 编辑器配色
       作者：hujie  创建：2026-09-18
       键名需与 App.axaml 的默认值、EditorSurface 的查询键保持一致。
       新增主题：复制本文件改色 → 在 ThemeService.Catalog 里登记。 -->


  <SolidColorBrush x:Key="EditorBackground" Color="#000000" />   <!-- 编辑器背景 -->
  <SolidColorBrush x:Key="EditorForeground" Color="#E0E0E0" />   <!-- 编辑器正文 -->
  <SolidColorBrush x:Key="EditorGutterBackground" Color="#0A0A0A" />   <!-- 行号槽背景 -->
  <SolidColorBrush x:Key="EditorGutterForeground" Color="#505050" />   <!-- 行号文字 -->
  <SolidColorBrush x:Key="EditorCurrentLine" Color="#111111" />   <!-- 当前行高亮 -->
  <SolidColorBrush x:Key="EditorSelection" Color="#1F3A5F" />   <!-- 选中区 -->
  <SolidColorBrush x:Key="TokDefault" Color="#E0E0E0" />   <!-- 默认 token -->
  <SolidColorBrush x:Key="TokKeyword" Color="#C792EA" />   <!-- 关键字 -->
  <SolidColorBrush x:Key="TokType" Color="#FFCB6B" />   <!-- 类型/类名 -->
  <SolidColorBrush x:Key="TokString" Color="#C3E88D" />   <!-- 字符串 -->
  <SolidColorBrush x:Key="TokNumber" Color="#F78C6C" />   <!-- 数字 -->
  <SolidColorBrush x:Key="TokComment" Color="#546E7A" />   <!-- 注释 -->
  <SolidColorBrush x:Key="TokPreproc" Color="#89DDFF" />   <!-- 预处理指令 -->
  <SolidColorBrush x:Key="TokBracket" Color="#E0E0E0" />   <!-- 括号（兜底，实际走 Rb0..Rb5） -->

  <!-- 彩虹括号：按嵌套深度取色（取自 LiteReader.cpp 的 COLORREF rb[6]） -->
  <SolidColorBrush x:Key="Rb0" Color="#4FC1FF" />
  <SolidColorBrush x:Key="Rb1" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Rb2" Color="#86C6C0" />
  <SolidColorBrush x:Key="Rb3" Color="#CE9178" />
  <SolidColorBrush x:Key="Rb4" Color="#4EC9B0" />
  <SolidColorBrush x:Key="Rb5" Color="#DCDCAA" />

  <SolidColorBrush x:Key="EditorMatchBackground" Color="#3A3A3A" />   <!-- 括号配对高亮 -->
  <SolidColorBrush x:Key="EditorMarkBackground" Color="#2A2A2A" />   <!-- 双击分词高亮（C++ markBg 0x002A2A2A） -->

  <!-- 右侧滑动导航条（自绘） -->
  <SolidColorBrush x:Key="EditorOverviewBackground" Color="#141414" />
  <SolidColorBrush x:Key="EditorOverviewThumb" Color="#3A3A3A" />

  <!-- 窗口外框跟随主题。极致黑主题的标题栏也压到接近纯黑，但留一点余量，
       好让标题栏与正文区（#000000）之间还能看出分界。
       机制与平台限制见 Services/WindowChrome.cs。 -->
  <SolidColorBrush x:Key="WindowCaptionBackground" Color="#0A0A0A" />   <!-- 标题栏底色 -->
  <SolidColorBrush x:Key="WindowCaptionForeground" Color="#E0E0E0" />   <!-- 标题文字 -->
  <SolidColorBrush x:Key="WindowBorder" Color="#2A2A2A" />              <!-- 外边框 -->

  <!-- 代码补全候选列表（自绘） -->
  <SolidColorBrush x:Key="CompletionBackground" Color="#0A0A0A" />
  <SolidColorBrush x:Key="CompletionBorder" Color="#333333" />
  <SolidColorBrush x:Key="CompletionForeground" Color="#E0E0E0" />
  <SolidColorBrush x:Key="CompletionSelectionBackground" Color="#1F3A5F" />
  <SolidColorBrush x:Key="CompletionSelectionForeground" Color="#FFFFFF" />

</ResourceDictionary>
