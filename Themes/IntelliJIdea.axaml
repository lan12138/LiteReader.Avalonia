<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="LiteReader.Themes.IntelliJIdea">

  <!-- IntelliJ IDEA Darcula（暗） · 编辑器配色
       作者：hujie  创建：2026-09-18
       键名需与 App.axaml 的默认值、EditorSurface 的查询键保持一致。
       新增主题：复制本文件改色 → 在 ThemeService.Catalog 里登记。 -->


  <SolidColorBrush x:Key="EditorBackground" Color="#2B2B2B" />   <!-- 编辑器背景 -->
  <SolidColorBrush x:Key="EditorForeground" Color="#A9B7C6" />   <!-- 编辑器正文 -->
  <SolidColorBrush x:Key="EditorGutterBackground" Color="#313335" />   <!-- 行号槽背景 -->
  <SolidColorBrush x:Key="EditorGutterForeground" Color="#606366" />   <!-- 行号文字 -->
  <SolidColorBrush x:Key="EditorCurrentLine" Color="#323232" />   <!-- 当前行高亮 -->
  <SolidColorBrush x:Key="EditorSelection" Color="#214283" />   <!-- 选中区 -->
  <SolidColorBrush x:Key="TokDefault" Color="#A9B7C6" />   <!-- 默认 token -->
  <SolidColorBrush x:Key="TokKeyword" Color="#CC7832" />   <!-- 关键字 -->
  <SolidColorBrush x:Key="TokType" Color="#A9B7C6" />   <!-- 类型/类名 -->
  <SolidColorBrush x:Key="TokString" Color="#6A8759" />   <!-- 字符串 -->
  <SolidColorBrush x:Key="TokNumber" Color="#6897BB" />   <!-- 数字 -->
  <SolidColorBrush x:Key="TokComment" Color="#808080" />   <!-- 注释 -->
  <SolidColorBrush x:Key="TokPreproc" Color="#BBB529" />   <!-- 预处理指令 -->
  <SolidColorBrush x:Key="TokBracket" Color="#A9B7C6" />   <!-- 括号（兜底，实际走 Rb0..Rb5） -->

  <!-- 彩虹括号：按嵌套深度取色（取自 LiteReader.cpp 的 COLORREF rb[6]） -->
  <SolidColorBrush x:Key="Rb0" Color="#A9B7C6" />
  <SolidColorBrush x:Key="Rb1" Color="#CC7832" />
  <SolidColorBrush x:Key="Rb2" Color="#6897BB" />
  <SolidColorBrush x:Key="Rb3" Color="#6A8759" />
  <SolidColorBrush x:Key="Rb4" Color="#FFC66D" />
  <SolidColorBrush x:Key="Rb5" Color="#999999" />

  <SolidColorBrush x:Key="EditorMatchBackground" Color="#094971" />   <!-- 括号配对高亮 -->
  <SolidColorBrush x:Key="EditorMarkBackground" Color="#46494A" />   <!-- 双击分词高亮（C++ markBg 0x004A4946） -->

  <!-- 右侧滑动导航条（自绘） -->
  <SolidColorBrush x:Key="EditorOverviewBackground" Color="#313335" />
  <SolidColorBrush x:Key="EditorOverviewThumb" Color="#5A5A5A" />

  <!-- 窗口外框跟随主题（取 IDEA 的 New UI 标题栏色）。
       机制与平台限制见 Services/WindowChrome.cs。 -->
  <SolidColorBrush x:Key="WindowCaptionBackground" Color="#313335" />   <!-- 标题栏底色 -->
  <SolidColorBrush x:Key="WindowCaptionForeground" Color="#A9B7C6" />   <!-- 标题文字 -->
  <SolidColorBrush x:Key="WindowBorder" Color="#4E5254" />              <!-- 外边框 -->

  <!-- 代码补全候选列表（自绘） -->
  <SolidColorBrush x:Key="CompletionBackground" Color="#3C3F41" />
  <SolidColorBrush x:Key="CompletionBorder" Color="#555555" />
  <SolidColorBrush x:Key="CompletionForeground" Color="#A9B7C6" />
  <SolidColorBrush x:Key="CompletionSelectionBackground" Color="#214283" />
  <SolidColorBrush x:Key="CompletionSelectionForeground" Color="#FFFFFF" />

</ResourceDictionary>
